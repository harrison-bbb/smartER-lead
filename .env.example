# Copy this file to .env and fill in the values

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://outreach:outreach_password@localhost:5432/outreach

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT Secrets (generate with: openssl rand -hex 32) ───────────────────────
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32_different

# ─── Encryption key for SMTP credentials (generate: openssl rand -hex 32) ────
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32_exactly_64_chars_here

# ─── Tracking ─────────────────────────────────────────────────────────────────
# Leave empty in dev (disables tracking pixel to avoid spam flags).
# Set to your public HTTPS domain in production: https://yourdomain.com
TRACKING_DOMAIN=

# ─── Google OAuth2 (for "Connect Gmail" button) ──────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials
# Enable Gmail API, create OAuth 2.0 Client ID (Web application)
# Redirect URI: http://localhost:3001/auth/google/callback
# Leave blank to disable Gmail connect (SMTP still works without this)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── AI (Claude) — for AI reply drafts in Inbox ───────────────────────────────
# Get your key at console.anthropic.com
# Leave blank to disable the "Draft with AI" feature
ANTHROPIC_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
